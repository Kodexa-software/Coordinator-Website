---
import GitHubIcon from './GitHubIcon.astro';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const links = [
  { href: '/docs/', label: 'Docs', current: path.startsWith('/docs/') && !path.startsWith('/docs/changelog') },
  { href: '/docs/changelog/', label: 'Changelog', current: path.startsWith('/docs/changelog') },
];
---

<header class="co-site-header">
  <div class="inner">
    <a class="home" href="/" aria-current={path === '/' ? 'page' : undefined}>
      <Logo class="home-logo" />
    </a>
    <nav aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a class="github" href="https://github.com/Kodexa-software/Coordinator">
        <GitHubIcon />
        <span>GitHub</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .co-site-header {
    position: relative;
    z-index: 1;
    border-block-end: 1px solid var(--co-line);
    background: var(--co-bg);
    view-transition-name: co-header;
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    box-sizing: border-box;
    max-width: 72rem;
    height: 4rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }
  .home {
    display: flex;
    min-width: 0;
    border-radius: var(--co-radius-sm);
  }
  .home :global(.home-logo) {
    height: 1.75rem;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--co-radius-sm);
    color: var(--co-ink-2);
    font-size: var(--co-text-sm);
    font-weight: var(--co-weight-medium);
    text-decoration: none;
    transition:
      color var(--co-dur-quick) var(--co-ease-arrive),
      background-color var(--co-dur-quick) var(--co-ease-arrive);
  }
  nav a:hover {
    color: var(--co-ink);
    background: var(--co-sunken);
  }
  nav a[aria-current='page'] {
    color: var(--co-accent-strong);
    background: var(--co-accent-soft);
  }
  @media (max-width: 30rem) {
    .inner {
      gap: 0.75rem;
      padding-inline: 1rem;
    }
    nav a {
      padding-inline: 0.5rem;
    }
    .github span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
