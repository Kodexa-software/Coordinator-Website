---
// A command in a code box with a copy button. Without JS the button stays hidden and the text can be selected.
interface Props {
  command: string;
  label: string;
}

const { command, label } = Astro.props;
// Lines may break between words and after a slash, never inside a word (so no "rm -" / "rf").
const words = command.split(' ').map((word) => word.split(/(?<=\/)/));
---

<div class="copy" data-copy={command}>
  <code>
    {
      words.map((parts, i) => (
        <>
          {i > 0 && ' '}
          {parts.map((part, j) => (
            <>
              {j > 0 && <wbr />}
              <span>{part}</span>
            </>
          ))}
        </>
      ))
    }
  </code>
  <button type="button" aria-label={`Copy ${label}`} hidden>
    <span class="icons">
      <svg class="icon copy-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <rect x="6.5" y="6.5" width="10" height="10" rx="2"></rect>
        <path d="M13.5 6.5V5a1.5 1.5 0 0 0-1.5-1.5H5A1.5 1.5 0 0 0 3.5 5v7A1.5 1.5 0 0 0 5 13.5h1.5"></path>
      </svg>
      <svg class="icon done-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M4.5 10.5l3.5 3.5 7.5-8"></path>
      </svg>
    </span>
    <span class="word">Copy</span>
  </button>
  <span class="status" role="status"></span>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    const button = root.querySelector('button');
    const word = root.querySelector('.word');
    const status = root.querySelector('[role="status"]');
    const code = root.querySelector('code');
    const text = root.dataset.copy;
    if (!button || !word || !status || !code || !text) continue;
    let timer = 0;
    button.hidden = false;
    button.addEventListener('click', async () => {
      clearTimeout(timer);
      status.textContent = '';
      await new Promise((done) => setTimeout(done, 60));
      try {
        await navigator.clipboard.writeText(text);
        root.dataset.state = 'copied';
        word.textContent = 'Copied';
        status.textContent = 'Copied to the clipboard';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(code);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
        status.textContent = "Couldn't copy. The command is selected: press Ctrl+C or ⌘C.";
      }
      timer = window.setTimeout(() => {
        delete root.dataset.state;
        word.textContent = 'Copy';
        status.textContent = '';
      }, 2400);
    });
  }
</script>

<style>
  .copy {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    border: 1px solid var(--co-line);
    border-radius: var(--co-radius-md);
    background: var(--co-sunken);
    transition: border-color var(--co-dur-quick) var(--co-ease-arrive);
  }
  .copy:hover,
  .copy:focus-within {
    border-color: var(--co-line-strong);
  }
  code {
    flex: 1;
    min-width: 0;
    padding-block: 0.5rem;
    color: var(--co-ink);
    font-family: var(--co-font-mono);
    font-size: var(--co-text-sm);
    line-height: 1.55;
  }
  code span {
    white-space: nowrap;
  }
  button {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    padding: 0 0.875rem 0 0.75rem;
    border: 0;
    border-radius: var(--co-radius-sm);
    background: var(--co-accent);
    color: var(--co-on-accent);
    font: inherit;
    font-size: var(--co-text-sm);
    font-weight: var(--co-weight-medium);
    cursor: pointer;
    transition:
      background-color var(--co-dur-quick) var(--co-ease-arrive),
      transform var(--co-dur-instant) var(--co-ease-arrive);
  }
  button[hidden] {
    display: none;
  }
  button:hover {
    background: var(--co-accent-strong);
  }
  button:active {
    transform: scale(0.97);
  }
  .icon {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      opacity var(--co-dur-quick) var(--co-ease-arrive),
      transform var(--co-dur-base) var(--co-ease-arrive);
  }
  .icons {
    display: grid;
  }
  .icons > * {
    grid-area: 1 / 1;
  }
  .done-icon {
    opacity: 0;
    transform: scale(0.6);
  }
  [data-state='copied'] .copy-icon {
    opacity: 0;
    transform: scale(0.6);
  }
  [data-state='copied'] .done-icon {
    opacity: 1;
    transform: none;
  }
  .word {
    min-width: 3.25em;
    text-align: start;
  }
  /* Narrow: a long command takes the whole line and the button wraps under it; a short one keeps it beside. */
  @media (max-width: 30rem) {
    .copy {
      flex-wrap: wrap;
      align-items: center;
      padding-inline-start: 0.875rem;
    }
    code {
      flex: 1 1 auto;
    }
    button {
      margin-inline-start: auto;
    }
  }
  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
